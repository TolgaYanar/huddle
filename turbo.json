{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "YOUTUBE_API_KEY",
    "API_PROXY_TARGET",
    "NEXT_PUBLIC_APP_RELEASE",
    "VERCEL_GIT_COMMIT_SHA",
    "NODE_ENV",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_DSN",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["YOUTUBE_API_KEY", "API_PROXY_TARGET"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["YOUTUBE_API_KEY", "API_PROXY_TARGET"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "env": ["YOUTUBE_API_KEY", "API_PROXY_TARGET"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["YOUTUBE_API_KEY", "API_PROXY_TARGET"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "env": ["YOUTUBE_API_KEY", "API_PROXY_TARGET"],
      "persistent": true
    }
  }
}
