# Backend proxy target
# Next.js rewrites /health, /socket.io*, /api/auth/*, /api/telemetry/* and
# /api/saved-rooms* to this host.
# Local development: http://localhost:4000
# Production (Vercel): https://your-backend.railway.app
API_PROXY_TARGET="http://localhost:4000"

# Optional public build identifier attached to anonymous sync-quality metrics.
# Vercel automatically falls back to VERCEL_GIT_COMMIT_SHA when this is unset.
# NEXT_PUBLIC_APP_RELEASE="local-dev"

# YouTube Data API v3 Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" for your project.
# Read by the route handlers in apps/web/app/api/:
#   youtube-search, youtube-playlist, youtube-preview, video-info
# Without it those routes return "YouTube browsing is not configured".
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY_HERE"

# Socket.IO endpoint override (optional) - leave unset in almost every case.
# Unset: localhost falls back to <hostname>:4000; in production the client uses
#        window.location.origin, so /socket.io goes through the Next.js rewrite
#        above and the HttpOnly session cookie rides along with the handshake.
# Empty string: forces same-origin explicitly.
# Only set an explicit wss://<backend-host> when that host shares a parent domain
# with the web app AND the server sets COOKIE_DOMAIN to that shared domain.
# A plain *.vercel.app + *.railway.app pair is cross-site: the session cookie is
# not sent and the socket connects unauthenticated.
# NEXT_PUBLIC_SOCKET_SERVER_URL=""

# WebRTC ICE servers (optional, JSON array in the RTCIceServer shape)
# Unset: a public STUN server only. That finds a path when at least one side
# has a cooperative NAT. Two people behind symmetric NAT — many mobile carriers,
# most corporate and campus networks — cannot reach each other without a TURN
# relay, and the call stays "connecting" until it fails. Add one here:
# NEXT_PUBLIC_ICE_SERVERS='[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:relay.example.com:3478"],"username":"user","credential":"secret"}]'
# A malformed value falls back to the STUN default rather than to no servers.

# Sentry error reporting (optional)
# Leave unset and the app runs with no error reporting and no Sentry code
# loaded. The DSN is a public identifier by design and is safe in the client
# bundle; the value that must stay secret is SENTRY_AUTH_TOKEN, which only CI
# needs in order to upload source maps.
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"
