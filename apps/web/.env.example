# Backend proxy target
# Next.js rewrites /health, /socket.io*, /api/auth/* and /api/saved-rooms* to this host.
# Local development: http://localhost:4000
# Production (Vercel): https://your-backend.railway.app
API_PROXY_TARGET="http://localhost:4000"

# YouTube Data API v3 Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" for your project.
# Read by the route handlers in apps/web/app/api/:
#   youtube-search, youtube-playlist, youtube-preview, video-info
# Without it those routes return "YouTube browsing is not configured".
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY_HERE"

# Socket.IO endpoint override (optional) - leave unset in almost every case.
# Unset: localhost falls back to <hostname>:4000; in production the client uses
#        window.location.origin, so /socket.io goes through the Next.js rewrite
#        above and the HttpOnly session cookie rides along with the handshake.
# Empty string: forces same-origin explicitly.
# Only set an explicit wss://<backend-host> when that host shares a parent domain
# with the web app AND the server sets COOKIE_DOMAIN to that shared domain.
# A plain *.vercel.app + *.railway.app pair is cross-site: the session cookie is
# not sent and the socket connects unauthenticated.
# NEXT_PUBLIC_SOCKET_SERVER_URL=""
