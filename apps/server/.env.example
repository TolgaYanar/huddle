# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://postgres:password@localhost:5432/huddle?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/huddle?schema=public"

# Optional: Server Port (defaults to 4000)
# PORT=4000

# CORS Origins (comma-separated list of allowed origins)
# For production: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# For development: CORS_ORIGINS=http://localhost:3002
# An empty value is NOT "allow all". src/cors.js reflects the request origin only
# when NODE_ENV != production; in production an empty allowlist fails closed and
# every browser origin is rejected (credentials: true makes reflection unsafe).
CORS_ORIGINS="http://localhost:3002"

# Node Environment
NODE_ENV="development"

# Optional: allow chrome-extension:// origins (Netflix party extension)
# Set to 1 or true to let the packed extension connect directly.
# ALLOW_EXTENSION_ORIGINS=0

# Optional: explicit session cookie domain
# Only needed when the API and the web app live on different subdomains of one
# parent domain. Required if the browser talks to this server directly (see
# NEXT_PUBLIC_SOCKET_SERVER_URL in apps/web/.env.example); without it a host-only
# session cookie may not reach the separate socket host.
# COOKIE_DOMAIN=".yourdomain.com"

# Optional: verbose request/socket logging
# VERBOSE_LOGS=0

# Note: YOUTUBE_API_KEY is NOT read by this server. It belongs to the web app
# (apps/web/.env.example), which owns the YouTube route handlers.

# Sentry error reporting (optional)
# Unset means no error reporting and no SDK loaded. A malformed value is
# rejected at startup rather than silently accepted, so "enabled" always means
# "will actually report".
# SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"

# TURN relay for WebRTC calls (optional, strongly recommended in production)
# Without a relay, two participants who are both behind symmetric NAT (mobile
# carriers, most corporate and campus networks) can never hear each other:
# STUN only finds a path when at least one side has a cooperative NAT.
#
# Credentials are issued per request by GET /api/webrtc/ice and never ship in
# the web bundle. Three modes, selected by which variables are set.
#
# 1) Cloudflare Realtime TURN (preferred). Create a TURN key in the Cloudflare
#    dashboard under Realtime -> TURN; it yields a key id and an API token.
#    The server exchanges them for a short-lived credential and caches it, so
#    Cloudflare is called about once per TTL rather than once per room join.
#    Includes turns:443, which reaches clients whose network blocks UDP.
# CLOUDFLARE_TURN_KEY_ID="<turn key id>"
# CLOUDFLARE_TURN_API_TOKEN="<turn key api token>"
#
# 2) Shared secret (TURN REST API — coturn `use-auth-secret`, and most managed
#    relays). Each credential is an HMAC that expires after TURN_TTL_SECONDS.
# TURN_URLS="turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp"
# TURN_SECRET="<the relay's static-auth-secret>"
#
# 3) Fixed pair, for relays that only hand out a static username/credential.
#    Refused under NODE_ENV=production: it cannot expire.
# TURN_USERNAME="<username>"
# TURN_CREDENTIAL="<credential>"
#
# Credential lifetime. Must outlast a call is NOT the rule here: the client
# refreshes and restarts ICE before expiry, so a shorter window simply limits
# what a leaked credential is worth. Cloudflare caps this at 172800 (48 h).
# TURN_TTL_SECONDS=3600   # 600..604800
#
# Refuse to boot unless a relay is actually configured. Use in production so a
# missing variable fails loudly instead of silently degrading every call.
# REQUIRE_TURN=1
#
# Optional: replace the default public STUN server.
# STUN_URLS="stun:stun.l.google.com:19302"
#
# A misconfiguration never breaks calls: the server logs `[ice] ...` warnings
# at boot and serves STUN only.
