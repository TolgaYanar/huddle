generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions   Session[]
  savedRooms SavedRoom[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SavedRoom {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId, createdAt])
}

model RoomMessage {
  id             String   @id @default(cuid())
  roomId         String
  senderId       String
  senderUsername String?
  text           String
  createdAt      DateTime @default(now())

  @@index([roomId, createdAt])
}

model RoomActivity {
  id             String   @id @default(cuid())
  roomId         String
  kind           String
  action         String?
  timestamp      Float?
  videoUrl       String?
  senderId       String?
  senderUsername String?
  createdAt      DateTime @default(now())

  @@index([roomId, createdAt])
}

model RoomState {
  roomId            String   @id
  name              String?
  videoUrl          String?
  // Derived from videoUrl on the server, never taken from the client. Answers
  // "which services do rooms actually watch", which is the evidence needed to
  // choose the next platform to support. Null means nothing is playing.
  platform          String?
  timestamp         Float    @default(0)
  isPlaying         Boolean  @default(false)
  activePlaylistId  String?
  activePlaylistIdx Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model RoomPlaylist {
  id                String   @id @default(cuid())
  roomId            String
  name              String
  description       String?
  createdBy         String
  createdByUsername String?
  isDefault         Boolean  @default(false)
  loop              Boolean  @default(false)
  shuffle           Boolean  @default(false)
  autoPlay          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items RoomPlaylistItem[]

  @@index([roomId, createdAt])
}

model RoomPlaylistItem {
  id              String   @id @default(cuid())
  playlistId      String
  videoUrl        String
  title           String
  duration        Float?
  thumbnail       String?
  addedBy         String
  addedByUsername String?
  position        Int      @default(0)
  addedAt         DateTime @default(now())

  playlist RoomPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId, position])
}

// One row per client session, written when the session ends (or is flushed).
//
// Deliberately a summary, not an event log: a room emits sync activity every
// few hundred milliseconds, so per-event rows would dwarf every other table
// and answer the same questions at far higher cost.
//
// Contains no room id, user id, socket id, content title or URL. `sessionId`
// is random and regenerated for every room page/platform segment, so rows
// cannot be joined back to a person. This is untrusted client input and must never inform an
// authorization, security or billing decision.
model SyncMetric {
  id        String  @id @default(cuid())
  sessionId String
  // Monotonic flush number. Older/duplicate snapshots never overwrite newer
  // cumulative counters when network delivery is reordered.
  sequence  Int
  // "web" | "extension"
  source    String
  // "youtube" | "netflix" | "twitch" | ... — never a URL.
  platform  String
  // Client build, so a regression can be attributed to a release.
  release   String?

  // Playback attachment
  playerFound   Int @default(0)
  playerMissing Int @default(0)

  // Command delivery: sent vs. actually applied by the player
  commandsSent    Int @default(0)
  commandsApplied Int @default(0)
  commandsFailed  Int @default(0)

  // Sync quality events
  joinAttempts     Int @default(0)
  joinSuccess      Int @default(0)
  reconnects       Int @default(0)
  hardSeeks        Int @default(0)
  catchupExhausted Int @default(0)
  autoplayBlocked  Int @default(0)
  contentMismatch  Int @default(0)

  // Drift histogram in seconds. Buckets rather than raw samples so a single
  // row stays small and p95 stays computable across sessions.
  driftLt1   Int @default(0)
  driftLt3   Int @default(0)
  driftLt5   Int @default(0)
  driftLt10  Int @default(0)
  driftGte10 Int @default(0)

  createdAt DateTime @default(now())
  // Retention horizon. telemetryCleanup sweeps rows past this.
  expiresAt DateTime

  @@unique([sessionId, source])
  @@index([expiresAt])
  @@index([platform, createdAt])
}
